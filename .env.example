# Leave as-is for local use. Only change this if you put Activepieces behind a
# real domain (e.g. reverse-proxied with HTTPS) - it must match how you actually
# reach the app, since it's used to build OAuth redirect URLs.
AP_FRONTEND_URL=http://localhost:8080

# Nothing else goes here. Your Gmail/Calendar OAuth, Telegram bot token, and OpenAI
# API key are all entered as Connections inside the Activepieces UI (Connections tab)
# and stored encrypted in its own database - not in this file, not in git.
